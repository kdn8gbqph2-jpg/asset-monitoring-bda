@model asset_monitoring.Models.AppPageModel

@if (Model.IsLoggedIn)
{
    <div class="d-flex justify-content-end align-items-center mb-4" style="gap: 0.75rem;">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-person-circle me-1"></i>@Model.Username
        </span>
        <form method="post" asp-page-handler="Logout" class="d-inline m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
        </form>
    </div>
}
