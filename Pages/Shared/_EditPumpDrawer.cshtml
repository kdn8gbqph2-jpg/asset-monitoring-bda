@{
    var _drawerUserType = Context.Session.GetString("UserType");
    var _canAssign = _drawerUserType == "ADMIN" || _drawerUserType == "JE";
}

<div class="offcanvas offcanvas-end" tabindex="-1" id="editPumpDrawer">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="pumpDrawerTitle">
            <i class="bi bi-pencil-square"></i> Edit Pump
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form id="editPumpForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editPumpId" />
            @* Contractor + its own pump number. Chosen from a list so the old
               free-text "Pump_2_X contractor" naming can't come back. *@
            <div class="mb-2">
                <label class="form-label d-flex justify-content-between align-items-center">
                    <span>Contractor</span>
                    <button type="button" id="toggleNewVendorBtn"
                            class="btn btn-link btn-sm p-0 text-decoration-none">
                        <i class="bi bi-plus-circle"></i> New contractor
                    </button>
                </label>
                <select class="form-select" id="editVendorId">
                    <option value="">— Loading… —</option>
                </select>
                <input type="text" class="form-control mt-2 d-none" id="editNewVendorName"
                       placeholder="New contractor name, e.g. Sharma Construction" />
            </div>

            <div class="row g-2 mb-2">
                <div class="col-5">
                    <label class="form-label small text-muted mb-1">Pump #</label>
                    <input type="number" min="1" class="form-control" id="editPumpNo" placeholder="auto" />
                </div>
                <div class="col-7 d-flex align-items-end">
                    <div class="small text-muted w-100">
                        Will appear as:<br />
                        <span id="pumpNamePreview" class="fw-semibold text-dark">—</span>
                    </div>
                </div>
            </div>

            @* Legacy free-text name. Kept only as a fallback for un-migrated rows;
               hidden so nobody types composites into it again. *@
            <input type="hidden" id="editVendorName" />
            <div class="mb-3">
                <label class="form-label d-flex justify-content-between align-items-center">
                    <span>Location</span>
                    <span id="locationGeoBadge"
                          class="badge bg-success-subtle text-success fw-normal d-none"
                          style="font-size:0.72rem;">
                        📍 From map
                    </span>
                </label>
                <input type="text" class="form-control" id="editLocationName"
                       placeholder="Type or drop pin on map" />
            </div>
            <!-- Map-based location picker -->
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-geo-alt"></i> Pin Location
                    <span class="text-muted fw-normal small ms-1">(drag pin or type coordinates)</span>
                </label>
                <div id="drawerMap" style="height:220px; border-radius:8px; border:1px solid #dee2e6; background:#f0f0f0;">
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted small">
                        <i class="bi bi-map me-1"></i> Loading map…
                    </div>
                </div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label small text-muted mb-1">Latitude</label>
                    <input type="number" step="any" class="form-control form-control-sm" id="editLatitude"
                           placeholder="27.2046">
                </div>
                <div class="col-6">
                    <label class="form-label small text-muted mb-1">Longitude</label>
                    <input type="number" step="any" class="form-control form-control-sm" id="editLongitude"
                           placeholder="77.5051">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Status</label>
                <select class="form-select" id="editStatus">
                    <option value="ON">ON</option>
                    <option value="OFF">OFF</option>
                    <option value="MAINTENANCE">MAINTENANCE</option>
                </select>
            </div>

            @if (_canAssign)
            {
                <div class="mb-3">
                    <label class="form-label">Assign Operator</label>
                    <select class="form-select" id="editOperatorMobile">
                        <option value="">— Loading… —</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Assign Junior Engineer</label>
                    <select class="form-select" id="editJeMobile">
                        <option value="">— Loading… —</option>
                    </select>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Remarks</label>
                <textarea class="form-control" id="editRemarks" rows="2"
                          placeholder="Optional comment…"></textarea>
            </div>
            <button type="button" id="pumpDrawerSaveBtn" class="btn btn-success w-100" onclick="savePump()">
                <i class="bi bi-check-circle"></i> Save Changes
            </button>
            @* Add-mode only: keeps the contractor, bumps the pump number and clears
               the location, since pumps are usually onboarded several at a time. *@
            <button type="button" id="pumpDrawerSaveAddAnotherBtn"
                    class="btn btn-outline-primary w-100 mt-2 d-none">
                <i class="bi bi-plus-circle"></i> Save &amp; add another for this contractor
            </button>
        </form>
    </div>
</div>
