@model IEnumerable<asset_monitoring.Services.DashboardPumpDto>
@{
    var userType    = Context.Session.GetString("UserType");
    var isAdmin     = userType == "ADMIN";
    var isJE        = userType == "JE";
    var isOperator  = userType == "OPERATOR";
}

<div class="card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-semibold text-primary m-0">
            <i class="bi bi-database-fill icon-title"></i>
            Pump Inventory
        </h5>

        <div>
            <div class="btn-group me-2">
                <a href="?handler=DownloadReportXlsx" class="btn btn-outline-success btn-sm" title="Download Excel">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </a>
                <a href="?handler=DownloadReportPdf" class="btn btn-outline-danger btn-sm" title="Download PDF">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </a>
                <a href="?handler=DownloadReport" class="btn btn-outline-secondary btn-sm" title="Download CSV">
                    <i class="bi bi-file-earmark-text"></i> CSV
                </a>
            </div>

            @if (isAdmin)
            {
                <button type="button" class="btn btn-primary btn-sm" onclick="openAddPumpDrawer()">
                    <i class="bi bi-plus-lg"></i> Add Pump
                </button>
            }
        </div>
    </div>

    <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
        <table class="table table-dashboard align-middle">
            <thead class="sticky-top" style="top: 0; z-index: 1;">
                <tr>
                    <th>PUMP ID</th>
                    <th>CONTRACTOR</th>
                    <th>PUMP #</th>
                    <th>LOCATION</th>
                    <th>OPERATOR</th>
                    <th>JUNIOR ENGINEER</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pump in Model)
                {
                    <tr class="@(pump.IsActive ? null : "table-secondary opacity-75")">
                        <td>
                            @pump.PumpId
                            @if (!pump.IsActive)
                            {
                                <span class="badge bg-secondary ms-1">Inactive</span>
                            }
                        </td>
                        @* Contractor + its own pump number. Un-migrated rows have no
                           ContractorName, so fall back to the legacy composite string. *@
                        <td>
                            @if (!string.IsNullOrEmpty(pump.ContractorName))
                            {
                                @pump.ContractorName
                            }
                            else
                            {
                                <span class="text-muted fst-italic">@pump.VendorName</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (pump.PumpNo.HasValue)
                            {
                                <span class="fw-semibold">Pump @pump.PumpNo</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@pump.Location</td>

                        <!-- Operator -->
                        <td>
                            @if (!string.IsNullOrEmpty(pump.OperatorName))
                            {
                                <span>@pump.OperatorName</span><br />
                                <small class="text-muted">@pump.OperatorMobile</small>
                            }
                            else if (!string.IsNullOrEmpty(pump.OperatorMobile))
                            {
                                <small class="text-muted">@pump.OperatorMobile</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <!-- Junior Engineer -->
                        <td>
                            @if (!string.IsNullOrEmpty(pump.JeName))
                            {
                                <span>@pump.JeName</span><br />
                                <small class="text-muted">@pump.JeMobile</small>
                            }
                            else if (!string.IsNullOrEmpty(pump.JeMobile))
                            {
                                <small class="text-muted">@pump.JeMobile</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <!-- Status -->
                        <td>
                            @if (pump.Status == "ON")
                            {
                                <span class="badge-status-on">ON</span>
                            }
                            else if (pump.Status == "MAINTENANCE")
                            {
                                <span class="badge bg-warning text-dark">MAINTENANCE</span>
                            }
                            else
                            {
                                <span class="badge-status-off">@pump.Status</span>
                            }
                        </td>

                        <!-- Actions -->
                        <td class="text-nowrap">
                            @* Change Status — Operator *@
                            @if (isOperator)
                            {
                                <button class="btn btn-warning btn-sm change-status-btn"
                                        data-pump-id="@pump.PumpId"
                                        data-vendor="@(pump.VendorName ?? "")"
                                        data-location="@(pump.Location ?? "")"
                                        data-status="@pump.Status"
                                        data-lat="@(pump.Latitude?.ToString() ?? "")"
                                        data-lng="@(pump.Longitude?.ToString() ?? "")"
                                        data-operator-mobile="@(pump.OperatorMobile ?? "")"
                                        data-je-mobile="@(pump.JeMobile ?? "")"
                                        title="Change Status">
                                    <i class="bi bi-toggle-on"></i> Change Status
                                </button>
                            }

                            @* Edit pump — Admin and JE *@
                            @if (isAdmin || isJE)
                            {
                                <button class="btn btn-primary btn-sm edit-pump-btn me-1"
                                        data-pump-id="@pump.PumpId"
                                        data-vendor-id="@(pump.VendorId?.ToString() ?? "")"
                                        data-pump-no="@(pump.PumpNo?.ToString() ?? "")"
                                        data-vendor="@pump.VendorName"
                                        data-location="@pump.Location"
                                        data-status="@pump.Status"
                                        data-lat="@pump.Latitude"
                                        data-lng="@pump.Longitude"
                                        data-operator-mobile="@(pump.OperatorMobile ?? "")"
                                        data-je-mobile="@(pump.JeMobile ?? "")"
                                        title="Edit Pump">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            }

                            @* Activate / Deactivate — Admin only. Deactivated pumps are
                               hidden from the dashboard but stay here so they can be re-enabled. *@
                            @if (isAdmin)
                            {
                                <form method="post"
                                      asp-page-handler="SetActive"
                                      asp-route-id="@pump.PumpId"
                                      asp-route-active="@((!pump.IsActive).ToString().ToLowerInvariant())"
                                      class="d-inline"
                                      onsubmit="return confirm('@(pump.IsActive ? "Deactivate this pump? It will be hidden from the dashboard." : "Activate this pump?")');">
                                    @Html.AntiForgeryToken()
                                    @if (pump.IsActive)
                                    {
                                        <button type="submit" class="btn btn-outline-warning btn-sm" title="Deactivate pump (hide from dashboard)">
                                            <i class="bi bi-pause-circle"></i> Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-success btn-sm" title="Activate pump">
                                            <i class="bi bi-play-circle"></i> Activate
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
