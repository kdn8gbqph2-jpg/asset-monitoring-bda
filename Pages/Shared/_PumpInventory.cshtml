@model IEnumerable<asset_monitoring.Services.DashboardPumpDto>
@{
    var isAdmin = Context.Session.GetString("UserType") == "ADMIN";
}

<div class="card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-semibold text-primary m-0">
            <i class="bi bi-database-fill icon-title"></i>
            Pump Inventory
        </h5>

        <div>
            <button type="button"
                    class="btn btn-outline-primary btn-sm me-2"
                    onclick="window.location.href='?handler=DownloadReport'">
                <i class="bi bi-file-earmark-excel"></i> Download Report
            </button>

            @if (isAdmin)
            {
                <button type="button" class="btn btn-primary btn-sm" onclick="openAddPumpDrawer()">
                    <i class="bi bi-plus-lg"></i> Add Pump
                </button>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dashboard align-middle">
            <thead>
                <tr>
                    <th>PUMP ID</th>
                    <th>VENDOR</th>
                    <th>LOCATION</th>
                    <th>OPERATOR</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pump in Model)
                {
                    <tr>
                        <td>@pump.PumpId</td>
                        <td>@pump.VendorName</td>
                        <td>@pump.Location</td>
                        <td>
                            @if (!string.IsNullOrEmpty(pump.OperatorName))
                            {
                                <span>@pump.OperatorName</span><br />
                                <small class="text-muted">@pump.OperatorMobile</small>
                            }
                            else
                            {
                                <span class="text-muted">@pump.OperatorMobile</span>
                            }
                        </td>
                        <td>
                            @if (pump.Status == "ON")
                            {
                                <span class="badge-status-on">ON</span>
                            }
                            else
                            {
                                <span class="badge-status-off">@pump.Status</span>
                            }
                        </td>
                        <td>
                            @* Use data-* attrs — avoids null/apostrophe injection in inline onclick *@
                            <button class="btn btn-primary btn-sm edit-pump-btn"
                                    data-pump-id="@pump.PumpId"
                                    data-vendor="@pump.VendorName"
                                    data-location="@pump.Location"
                                    data-status="@pump.Status"
                                    data-lat="@pump.Latitude"
                                    data-lng="@pump.Longitude"
                                    title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>

                            @if (isAdmin)
                            {
                                <form method="post"
                                      asp-page-handler="DeletePump"
                                      asp-route-id="@pump.PumpId"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this pump?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
