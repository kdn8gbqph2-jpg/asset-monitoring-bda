@model asset_monitoring.Services.PumpRunningSummaryResult
@{
    var ist = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");

    string FormatRunTime(int minutes)
    {
        if (minutes <= 0) return "—";
        var h = minutes / 60;
        var m = minutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    string ToIst(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), ist)
            .ToString("dd MMM, hh:mm tt");

    // Earliest selectable month for the picker. Anchored well in the past so
    // historical browsing is unconstrained; the service clamps invalid input.
    var pickerMin = "2024-01";
    var pickerMax = $"{DateTime.Now.Year:D4}-{DateTime.Now.Month:D2}";

    var rows = Model?.Rows ?? new List<asset_monitoring.Services.PumpRunningSummaryDto>();
    var monthLabel = Model?.MonthLabel ?? DateTime.Now.ToString("MMMM yyyy");
    var isCurrent  = Model?.IsCurrentMonth ?? true;
    var isoMonth   = Model?.IsoMonthValue ?? $"{DateTime.Now.Year:D4}-{DateTime.Now.Month:D2}";
    var selYear    = Model?.Year  ?? DateTime.Now.Year;
    var selMonth   = Model?.Month ?? DateTime.Now.Month;

    // Colspan for the empty-state row: 1 select + 4 base + 3 today (if current) + 3 month + 1 last updated
    var emptyColspan = isCurrent ? 12 : 9;

    // Group the pumps by contractor so each contractor is one collapsible block
    // (this is what vendor normalisation bought us — a real per-contractor rollup).
    var contractorGroups = rows
        .GroupBy(r => string.IsNullOrWhiteSpace(r.ContractorName) ? "Unassigned" : r.ContractorName!)
        .OrderBy(g => g.Key)
        .Select(g => new
        {
            Contractor = g.Key,
            Pumps      = g.OrderBy(p => p.PumpNo ?? int.MaxValue).ThenBy(p => p.PumpId).ToList(),
            MonthRun   = g.Sum(p => p.MonthRunMinutes),
            TodayRun   = g.Sum(p => p.TodayRunMinutes),
            RunningNow = g.Count(p => p.Status == "ON")
        })
        .ToList();
}

<div class="card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 0.75rem;">
        <h5 class="fw-semibold text-primary m-0">
            <i class="bi bi-bar-chart-line-fill icon-title"></i>
            Pump Running Summary
        </h5>
        <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
            <label for="summaryMonthPicker" class="form-label small text-muted m-0">
                <i class="bi bi-calendar3 me-1"></i>Month
            </label>
            <input type="month"
                   id="summaryMonthPicker"
                   class="form-control form-control-sm"
                   style="width: 11rem;"
                   value="@isoMonth"
                   min="@pickerMin"
                   max="@pickerMax" />
            <div class="btn-group btn-group-sm" role="group" aria-label="Export running summary">
                <a class="btn btn-outline-success"
                   title="Download Excel"
                   href="?handler=DownloadRunningSummaryXlsx&summaryYear=@selYear&summaryMonth=@selMonth">
                    <i class="bi bi-file-earmark-excel"></i>
                    <span class="d-none d-sm-inline ms-1">Excel</span>
                </a>
                <a class="btn btn-outline-danger"
                   title="Download PDF"
                   href="?handler=DownloadRunningSummaryPdf&summaryYear=@selYear&summaryMonth=@selMonth">
                    <i class="bi bi-file-earmark-pdf"></i>
                    <span class="d-none d-sm-inline ms-1">PDF</span>
                </a>
                <a class="btn btn-outline-secondary"
                   title="Download CSV"
                   href="?handler=DownloadRunningSummaryCsv&summaryYear=@selYear&summaryMonth=@selMonth">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    <span class="d-none d-sm-inline ms-1">CSV</span>
                </a>
            </div>
            <button type="button" id="downloadRunningLogBtn" class="btn btn-sm btn-primary"
                    title="Tick one or more pumps below, then download their detailed running log (Excel) with total running hours">
                <i class="bi bi-clipboard-data"></i>
                <span class="d-none d-sm-inline ms-1">Running Log</span>
            </button>
        </div>
    </div>

    @if (!isCurrent)
    {
        <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center" style="gap: 0.4rem;">
            <i class="bi bi-clock-history"></i>
            <span>
                Viewing historical data for <strong>@monthLabel</strong>. Status and Operator
                columns reflect the pump's <em>current</em> values.
            </span>
        </div>
    }

    <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
        <table class="table table-dashboard summary-table align-middle text-center">
            <thead class="sticky-top" style="top: 0; z-index: 2;">
                <tr>
                    <th rowspan="2" class="align-middle">
                        <input type="checkbox" id="rlSelectAll" title="Select / deselect all pumps" />
                    </th>
                    <th rowspan="2" class="align-middle text-start">PUMP ID</th>
                    <th rowspan="2" class="align-middle text-start col-hide-mobile">PUMP</th>
                    <th rowspan="2" class="align-middle text-start col-hide-mobile">LOCATION</th>
                    <th rowspan="2" class="align-middle">STATUS</th>
                    @if (isCurrent)
                    {
                        <th colspan="3" class="text-center border-bottom-0 d-none d-sm-table-cell"
                            style="background:#e8f5e9; color:#2e7d32;">
                            <i class="bi bi-sun me-1"></i>TODAY
                        </th>
                        <th class="text-center border-bottom-0 d-sm-none"
                            style="background:#e8f5e9; color:#2e7d32;">
                            <i class="bi bi-sun me-1"></i>TODAY
                        </th>
                    }
                    <th colspan="3" class="text-center border-bottom-0 d-none d-sm-table-cell"
                        style="background:#e3f2fd; color:#1565c0;">
                        <i class="bi bi-calendar3 me-1"></i>@monthLabel.ToUpper()
                    </th>
                    <th class="text-center border-bottom-0 d-sm-none"
                        style="background:#e3f2fd; color:#1565c0;">
                        <i class="bi bi-calendar3 me-1"></i>@monthLabel
                    </th>
                    <th rowspan="2" class="align-middle col-hide-mobile">LAST UPDATED</th>
                </tr>
                <tr>
                    @if (isCurrent)
                    {
                        @* Today sub-columns *@
                        <th style="background:#e8f5e9; font-size:0.75rem;">
                            <i class="bi bi-play-circle text-success"></i> Running
                        </th>
                        <th class="col-hide-mobile" style="background:#e8f5e9; font-size:0.75rem;">
                            <i class="bi bi-stop-circle text-danger"></i> OFF
                        </th>
                        <th class="col-hide-mobile" style="background:#e8f5e9; font-size:0.75rem;">
                            <i class="bi bi-wrench text-warning"></i> Maint.
                        </th>
                    }
                    @* Month sub-columns *@
                    <th style="background:#e3f2fd; font-size:0.75rem;">
                        <i class="bi bi-play-circle text-success"></i> Running
                    </th>
                    <th class="col-hide-mobile" style="background:#e3f2fd; font-size:0.75rem;">
                        <i class="bi bi-stop-circle text-danger"></i> OFF
                    </th>
                    <th class="col-hide-mobile" style="background:#e3f2fd; font-size:0.75rem;">
                        <i class="bi bi-wrench text-warning"></i> Maint.
                    </th>
                </tr>
            </thead>
            <tbody>
            @if (rows == null || !rows.Any())
            {
                <tr>
                    <td colspan="@emptyColspan" class="text-center text-muted py-3">No data available</td>
                </tr>
            }
            else
            {
                foreach (var grp in contractorGroups)
                {
                    var gid = "grp-" + grp.Contractor.GetHashCode().ToString("X");
                    @* Contractor header — click to collapse/expand this contractor's pumps *@
                    <tr class="contractor-group-header" data-group="@gid">
                        <td>
                            <input type="checkbox" class="rl-select-group" data-group="@gid"
                                   title="Select all of @grp.Contractor's pumps"
                                   onclick="event.stopPropagation();" />
                        </td>
                        <td colspan="@(emptyColspan - 1)" class="text-start">
                            <i class="bi bi-chevron-down grp-chevron me-1"></i>
                            <span class="fw-semibold">@grp.Contractor</span>
                            <span class="badge bg-secondary ms-2">@grp.Pumps.Count pumps</span>
                            @if (grp.RunningNow > 0)
                            {
                                <span class="badge bg-success-subtle text-success ms-1">@grp.RunningNow running</span>
                            }
                            <span class="ms-3 small text-muted">
                                @monthLabel:
                                <span class="fw-semibold @(grp.MonthRun > 0 ? "text-success" : "text-muted")">@FormatRunTime(grp.MonthRun)</span>
                                @if (isCurrent)
                                {
                                    <span class="ms-2">
                                        · Today:
                                        <span class="fw-semibold @(grp.TodayRun > 0 ? "text-success" : "text-muted")">@FormatRunTime(grp.TodayRun)</span>
                                    </span>
                                }
                            </span>
                        </td>
                    </tr>

                foreach (var item in grp.Pumps)
                {
                    <tr class="contractor-row" data-group="@gid">
                        <td>
                            <input type="checkbox" class="rl-select" value="@item.PumpId" data-group="@gid"
                                   title="Select pump @item.PumpId for the running-log download" />
                        </td>
                        <td class="fw-semibold text-start">
                            <a href="javascript:void(0)" class="text-primary text-decoration-none"
                               onclick="openSummaryPumpDetail(@item.PumpId, '@(item.VendorName?.Replace("'", "\\'") ?? "")', '@(item.Location?.Replace("'", "\\'") ?? "")', '@(item.Status ?? "OFF")')">
                                @item.PumpId
                            </a>
                        </td>
                        @* Contractor lives in the group header, so the row only needs its number *@
                        <td class="text-start col-hide-mobile">
                            @if (item.PumpNo.HasValue)
                            {
                                <span>Pump @item.PumpNo</span>
                            }
                            else
                            {
                                <span class="text-muted">@item.VendorName</span>
                            }
                        </td>
                        <td class="text-start col-hide-mobile">@item.Location</td>
                        <td>
                            @if (item.Status == "ON")
                            {
                                <span class="badge-status-on">ON</span>
                            }
                            else if (item.Status == "MAINTENANCE")
                            {
                                <span class="badge bg-warning text-dark fw-semibold px-2 py-1">MAINTENANCE</span>
                            }
                            else
                            {
                                <span class="badge-status-off">OFF</span>
                            }
                        </td>
                        @if (isCurrent)
                        {
                            @* ── Today columns ── *@
                            <td>
                                <span class="fw-semibold @(item.TodayRunMinutes > 0 ? "text-success" : "text-muted")">
                                    @FormatRunTime(item.TodayRunMinutes)
                                </span>
                            </td>
                            <td class="col-hide-mobile">
                                <span class="fw-semibold @(item.TodayOffMinutes > 0 ? "text-danger" : "text-muted")">
                                    @FormatRunTime(item.TodayOffMinutes)
                                </span>
                            </td>
                            <td class="col-hide-mobile">
                                <span class="fw-semibold @(item.TodayMaintenanceMinutes > 0 ? "text-warning" : "text-muted")">
                                    @FormatRunTime(item.TodayMaintenanceMinutes)
                                </span>
                            </td>
                        }
                        @* ── Month columns ── *@
                        <td>
                            <span class="fw-semibold @(item.MonthRunMinutes > 0 ? "text-success" : "text-muted")">
                                @FormatRunTime(item.MonthRunMinutes)
                            </span>
                        </td>
                        <td class="col-hide-mobile">
                            <span class="fw-semibold @(item.MonthOffMinutes > 0 ? "text-danger" : "text-muted")">
                                @FormatRunTime(item.MonthOffMinutes)
                            </span>
                        </td>
                        <td class="col-hide-mobile">
                            <span class="fw-semibold @(item.MonthMaintenanceMinutes > 0 ? "text-warning" : "text-muted")">
                                @FormatRunTime(item.MonthMaintenanceMinutes)
                            </span>
                        </td>
                        <td class="text-muted small col-hide-mobile">
                            @ToIst(item.LastUpdated)
                        </td>
                    </tr>
                }
                }
            }
            </tbody>
        </table>
    </div>
</div>

<!-- ================= PUMP DETAIL MODAL (Summary) ================= -->
<div class="modal fade" id="summaryPumpDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i>
                    Pump Detail — <span id="spPumpId"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-sm-4">
                        <div class="fw-semibold text-muted small">Vendor</div>
                        <div id="spVendor"></div>
                    </div>
                    <div class="col-sm-4">
                        <div class="fw-semibold text-muted small">Location</div>
                        <div id="spLocation"></div>
                    </div>
                    <div class="col-sm-4">
                        <div class="fw-semibold text-muted small">Status</div>
                        <div id="spStatus"></div>
                    </div>
                </div>
                <h6 class="fw-bold mb-2">Status History</h6>
                <div class="pump-log-legend">
                    <span><span class="swatch swatch-on"></span>Running (ON)</span>
                    <span><span class="swatch swatch-off"></span>Stopped (OFF)</span>
                    <span><span class="swatch swatch-maint"></span>Maintenance</span>
                </div>
                <div id="spLogSpinner" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2 text-muted">Loading…</span>
                </div>
                <div id="spLogEmpty" class="text-muted small d-none">No history found.</div>
                <div class="table-responsive d-none" id="spLogTableWrap">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th><th>Old</th><th>New</th>
                                <th>Started</th><th>Ended</th><th>Duration</th>
                                <th>Remarks</th><th>Operator</th>
                            </tr>
                        </thead>
                        <tbody id="spLogBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// ── Month picker: navigate to selected period ────────────────────────────
(function () {
    const picker = document.getElementById('summaryMonthPicker');
    if (!picker) return;
    picker.addEventListener('change', () => {
        const v = picker.value;          // "YYYY-MM"
        if (!v || !/^\d{4}-\d{2}$/.test(v)) return;
        const [y, m] = v.split('-');
        const url = new URL(window.location.href);
        url.searchParams.set('summaryYear', y);
        url.searchParams.set('summaryMonth', String(parseInt(m, 10))); // strip leading zero
        window.location.href = url.toString();
    });
})();

// ── Contractor groups: collapse / expand + per-group select ──────────────
(function () {
    // Toggle a contractor's pump rows. Plain class toggling rather than Bootstrap
    // collapse, which fights <tr> display semantics.
    document.querySelectorAll('.contractor-group-header').forEach(hdr => {
        hdr.addEventListener('click', () => {
            const gid = hdr.dataset.group;
            const collapsed = hdr.classList.toggle('collapsed');
            document.querySelectorAll(`tr.contractor-row[data-group="${gid}"]`)
                .forEach(tr => tr.classList.toggle('d-none', collapsed));
        });
    });

    // Group checkbox ticks/unticks just that contractor's pumps.
    document.querySelectorAll('.rl-select-group').forEach(gcb => {
        gcb.addEventListener('change', () => {
            document.querySelectorAll(`.rl-select[data-group="${gcb.dataset.group}"]`)
                .forEach(cb => { cb.checked = gcb.checked; });
        });
    });
})();

// ── Running Log: select pumps, then download their detailed log (Excel) ───
(function () {
    const all = document.getElementById('rlSelectAll');
    if (all) {
        all.addEventListener('change', () => {
            document.querySelectorAll('.rl-select').forEach(cb => { cb.checked = all.checked; });
            document.querySelectorAll('.rl-select-group').forEach(cb => { cb.checked = all.checked; });
        });
    }

    const btn = document.getElementById('downloadRunningLogBtn');
    if (btn) {
        btn.addEventListener('click', () => {
            const ids = Array.from(document.querySelectorAll('.rl-select:checked')).map(cb => cb.value);
            if (ids.length === 0) {
                alert('Tick one or more pumps (checkbox on the left) to download their running log.');
                return;
            }
            const params = new URLSearchParams();
            params.set('handler', 'DownloadRunningLogXlsx');
            params.set('summaryYear', '@selYear');
            params.set('summaryMonth', '@selMonth');
            params.set('pumpIds', ids.join(','));
            window.location.href = window.location.pathname + '?' + params.toString();
        });
    }
})();

function openSummaryPumpDetail(pumpId, vendor, location, status) {
    document.getElementById('spPumpId').textContent  = pumpId;
    document.getElementById('spVendor').textContent  = vendor  || '—';
    document.getElementById('spLocation').textContent = location || '—';

    const badgeMap = {
        'ON':          '<span class="badge-status-on">ON</span>',
        'OFF':         '<span class="badge-status-off">OFF</span>',
        'MAINTENANCE': '<span class="badge bg-warning text-dark">MAINTENANCE</span>'
    };
    document.getElementById('spStatus').innerHTML =
        badgeMap[status] ?? '<span class="badge bg-secondary">UNKNOWN</span>';

    document.getElementById('spLogSpinner').classList.remove('d-none');
    document.getElementById('spLogEmpty').classList.add('d-none');
    document.getElementById('spLogTableWrap').classList.add('d-none');
    document.getElementById('spLogBody').innerHTML = '';

    bootstrap.Modal.getOrCreateInstance(
        document.getElementById('summaryPumpDetailModal')).show();

    fetch(`/Dashboard?handler=PumpLogs&pumpId=${pumpId}`)
        .then(r => r.json())
        .then(data => {
            document.getElementById('spLogSpinner').classList.add('d-none');
            if (!data.success || !data.logs || data.logs.length === 0) {
                document.getElementById('spLogEmpty').classList.remove('d-none');
                return;
            }
            const tbody = document.getElementById('spLogBody');
            const esc = s => (s == null || s === '') ? '—' : String(s)
                .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            data.logs.forEach((l, i) => {
                const fmt = dt => dt ? new Date(dt).toLocaleString('en-IN') : '—';
                const dur = fmtDuration(l.durationMinutes);
                // Serial number per pump in chronological order:
                // #1 = oldest event, #N = most recent. Rows are
                // rendered newest-first, so the bottom row gets #1.
                const serial = data.logs.length - i;
                // Shade the row by the status held DURING this period — that's
                // OldStatus (Duration = time in Old; New is the end transition).
                const rowClass = pumpLogRowClass(l.oldStatus);
                tbody.insertAdjacentHTML('beforeend', `
                    <tr class="${rowClass}">
                        <td class="text-muted small">${serial}</td>
                        <td>${esc(l.oldStatus)}</td>
                        <td><strong>${esc(l.newStatus)}</strong></td>
                        <td class="text-nowrap small">${fmt(l.startTime)}</td>
                        <td class="text-nowrap small">${fmt(l.endTime)}</td>
                        <td>${esc(dur)}</td>
                        <td>${esc(l.remarks)}</td>
                        <td>${esc(l.updatedBy)}</td>
                    </tr>`);
            });
            document.getElementById('spLogTableWrap').classList.remove('d-none');
        })
        .catch(err => {
            console.error('Failed to load pump logs', err);
            document.getElementById('spLogSpinner').classList.add('d-none');
            document.getElementById('spLogEmpty').textContent = 'Error loading history.';
            document.getElementById('spLogEmpty').classList.remove('d-none');
        });
}
</script>
