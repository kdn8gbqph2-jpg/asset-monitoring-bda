@*
    Change-Password modal — reusable partial.
    Included from _LoginHeader; POSTs to ?handler=ChangePassword on the current page.
    The handler lives on AppPageModel so every page (Operator/JE/Admin) has it.
*@
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changePasswordModalLabel">
                    <i class="bi bi-shield-lock me-2"></i>Change Password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()

                <div id="cpAlert" class="alert d-none" role="alert"></div>

                <div class="mb-3">
                    <label for="cpCurrent" class="form-label fw-semibold">Current Password</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="cpCurrent" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary" data-cp-toggle="cpCurrent" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="cpNew" class="form-label fw-semibold">New Password</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="cpNew" autocomplete="new-password" minlength="8" />
                        <button type="button" class="btn btn-outline-secondary" data-cp-toggle="cpNew" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="form-text">Must be at least 8 characters.</div>
                </div>

                <div class="mb-2">
                    <label for="cpConfirm" class="form-label fw-semibold">Confirm New Password</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="cpConfirm" autocomplete="new-password" minlength="8" />
                        <button type="button" class="btn btn-outline-secondary" data-cp-toggle="cpConfirm" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div id="cpMatchHint" class="form-text text-danger d-none">Passwords do not match.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="cpSaveBtn">
                    <i class="bi bi-check-circle me-1"></i>Update Password
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    if (window.__changePwdInit) return;
    window.__changePwdInit = true;

    document.addEventListener('DOMContentLoaded', function () {
        const modalEl    = document.getElementById('changePasswordModal');
        if (!modalEl) return;

        const alertBox   = document.getElementById('cpAlert');
        const curInput   = document.getElementById('cpCurrent');
        const newInput   = document.getElementById('cpNew');
        const confInput  = document.getElementById('cpConfirm');
        const matchHint  = document.getElementById('cpMatchHint');
        const saveBtn    = document.getElementById('cpSaveBtn');

        const showAlert = (type, msg) => {
            alertBox.className = 'alert alert-' + type;
            alertBox.textContent = msg;
            alertBox.classList.remove('d-none');
        };
        const clearAlert = () => alertBox.classList.add('d-none');

        const resetForm = () => {
            curInput.value = ''; newInput.value = ''; confInput.value = '';
            matchHint.classList.add('d-none');
            clearAlert();
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Update Password';
        };

        modalEl.addEventListener('show.bs.modal', resetForm);

        // Password visibility toggles
        document.querySelectorAll('[data-cp-toggle]').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = document.getElementById(btn.dataset.cpToggle);
                if (!target) return;
                const icon = btn.querySelector('i');
                if (target.type === 'password') {
                    target.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    target.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });

        // Live match check
        const checkMatch = () => {
            if (confInput.value && newInput.value !== confInput.value) {
                matchHint.classList.remove('d-none');
            } else {
                matchHint.classList.add('d-none');
            }
        };
        newInput.addEventListener('input', checkMatch);
        confInput.addEventListener('input', checkMatch);

        saveBtn.addEventListener('click', async function () {
            clearAlert();

            const cur  = curInput.value;
            const pwd  = newInput.value;
            const conf = confInput.value;

            if (!cur || !pwd || !conf) {
                showAlert('warning', 'All fields are required.');
                return;
            }
            if (pwd.length < 8) {
                showAlert('warning', 'New password must be at least 8 characters.');
                return;
            }
            if (pwd !== conf) {
                showAlert('warning', 'New password and confirmation do not match.');
                return;
            }
            if (cur === pwd) {
                showAlert('warning', 'New password must be different from the current password.');
                return;
            }

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const res = await fetch('?handler=ChangePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        currentPassword: cur,
                        newPassword: pwd,
                        confirmPassword: conf
                    })
                });

                let data = {};
                try { data = await res.json(); } catch (_) {}

                if (res.ok && data.success) {
                    showAlert('success', data.message || 'Password changed successfully.');
                    setTimeout(() => {
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                    }, 1200);
                } else {
                    showAlert('danger', data.message || 'Failed to change password.');
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Update Password';
                }
            } catch (err) {
                showAlert('danger', 'Network error. Please try again.');
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Update Password';
            }
        });
    });
})();
</script>
