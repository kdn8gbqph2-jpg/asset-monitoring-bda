
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - asset_monitoring</title>
    <link rel="icon" type="image/png" href="~/images/bda-logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/asset_monitoring.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar dashboard-navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-0">
            <div class="container-fluid d-flex align-items-center">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="~/images/bda-logo.png" alt="BDA logo" style="height:40px; width:auto;" />
                    <span class="ms-2 fw-semibold">Bharatpur Development Authority</span>
                </a>
                <a href="https://services.bdabharatpur.org" class="nav-home ms-auto"
                   title="Return to all BDA services">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    <span class="d-none d-sm-inline ms-1">Return to All Services</span>
                </a>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center py-3 bg-light">
        <p class="mb-2 footer-social">
            <span class="footer-social-label">Follow us on</span>
            <a href="https://www.instagram.com/bdabharatpurofficial/"
               target="_blank" rel="noopener"
               class="social-link social-instagram"
               title="Instagram: @@bdabharatpurofficial"
               aria-label="Instagram">
                <i class="bi bi-instagram"></i>
            </a>
            <a href="https://www.facebook.com/bdabharatpur"
               target="_blank" rel="noopener"
               class="social-link social-facebook"
               title="Facebook: Bharatpur Development Authority"
               aria-label="Facebook">
                <i class="bi bi-facebook"></i>
            </a>
            <a href="https://x.com/Bdabharatpur"
               target="_blank" rel="noopener"
               class="social-link social-x"
               title="X: @@Bdabharatpur"
               aria-label="X (formerly Twitter)">
                <i class="bi bi-twitter-x"></i>
            </a>
        </p>
        <p class="mb-1">
            &copy; @DateTime.Now.Year Bharatpur Development Authority. All rights reserved.
        </p>
        <p class="mb-0 text-muted">
            <a asp-page="/About" class="text-decoration-none fw-semibold" style="font-size: 1rem;">
                <i class="bi bi-info-circle"></i> About
            </a>
            <span class="mx-2">·</span>
            <span class="small">v@(asset_monitoring.Pages.AboutModel.AppVersion)</span>
        </p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
