@page
@model asset_monitoring.Pages.DashboardModel
@{
    ViewData["Title"] = "Monsoon Pump Dashboard";
    ViewData["ShowITCellCredit"] = true;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

<!-- ================= DARK NAVBAR ================= -->
<div class="dash-navbar">
    <div class="nav-actions">
        <a href="?handler=DownloadReportXlsx" class="btn-nav btn-nav-excel" title="Download Excel">
            <i class="bi bi-file-earmark-excel"></i> <span class="btn-nav-label">Excel</span>
        </a>
        <a href="?handler=DownloadReportPdf" class="btn-nav btn-nav-pdf" title="Download PDF">
            <i class="bi bi-file-earmark-pdf"></i> <span class="btn-nav-label">PDF</span>
        </a>
        <a href="?handler=DownloadReport" class="btn-nav btn-nav-csv" title="Download CSV">
            <i class="bi bi-file-earmark-spreadsheet"></i> <span class="btn-nav-label">CSV</span>
        </a>
    </div>
    <div class="nav-title-wrap">
        <div class="nav-title dashboard-title">Monsoon Pump Dashboard</div>
        <div class="dashboard-tagline">Real-time pump status &mdash; operator-logged, engineer-supervised.</div>
    </div>
    <div class="nav-actions">
        <button class="btn-nav btn-nav-primary"
                data-bs-toggle="modal"
                data-bs-target="#loginModal">
            <i class="bi bi-person-circle" style="font-size:1.1rem;vertical-align:middle;"></i>
            <span style="vertical-align:middle; margin-left:5px;">Sign in</span>
        </button>
    </div>
</div>

<div class="container-fluid px-4">

    <!-- ================= KPI SECTION ================= -->
    <div class="row mb-4">
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-blue">
                <div class="kpi-title">Total Pumps</div>
                <div class="kpi-value" id="kpiTotal">@Model.TotalPumps</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-green">
                <div class="kpi-title">Running</div>
                <div class="kpi-value" id="kpiRunning">@Model.RunningPumpCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-red">
                <div class="kpi-title">Offline</div>
                <div class="kpi-value" id="kpiOffline">@Model.OfflinePumpCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-yellow">
                <div class="kpi-title">Maintenance</div>
                <div class="kpi-value" id="kpiMaint">@Model.MaintenancePumpCount</div>
            </div>
        </div>
    </div>

    <!-- ================= MAP / LIST TOGGLE ================= -->
    <div class="mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <button class="btn btn-outline-secondary btn-sm view-btn" id="btnMap">
                <i class="bi bi-map"></i> <span class="d-none d-sm-inline">Map View</span><span class="d-sm-none">Map</span>
            </button>
            <button class="btn btn-outline-secondary btn-sm view-btn" id="btnList">
                <i class="bi bi-list-ul"></i> <span class="d-none d-sm-inline">List View</span><span class="d-sm-none">List</span>
            </button>
            <button class="btn btn-outline-danger btn-sm" id="btnReset" title="Reset view, filters and sort">
                <i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-sm-inline">Reset</span>
            </button>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span id="lastUpdatedLabel" class="small text-muted fst-italic">Updated just now</span>
        </div>
    </div>

    <!-- ================= MAP + TABLE ================= -->
    <div class="row g-3 mb-4" id="dashboardRow">
        <div class="col-12 col-md-6" id="mapCol">
            <div class="card h-100 p-3">
                <div id="map" style="height: 100%; min-height: 400px;">
                    <div class="text-muted">Pump Locations</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6" id="tableCol">
            <div class="card h-100 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 px-3 pt-2 pb-1 small flex-wrap status-legend">
                    <span class="fw-semibold text-muted">Status:</span>
                    <span><span class="badge-status-on">ON</span> Running</span>
                    <span><span class="badge-status-off">OFF</span> Stopped</span>
                    <span><span class="badge-status-maint">MAINT</span> Maintenance</span>
                </div>
                <div class="table-responsive">
                <table class="table table-dashboard mb-0 align-middle">
                    <thead>
                        <tr>
                            <th class="sortable" data-col="0" data-type="num">Pump ID <span class="sort-icon">⇅</span></th>
                            <th class="sortable" data-col="1" data-type="str">Vendor <span class="sort-icon">⇅</span></th>
                            <th class="sortable" data-col="2" data-type="str">Location <span class="sort-icon">⇅</span></th>
                            <th class="sortable" data-col="3" data-type="str">Operator <span class="sort-icon">⇅</span></th>
                            <th class="sortable" data-col="4" data-type="str">JE <span class="sort-icon">⇅</span></th>
                            <th class="col-sticky-right sortable" data-col="5" data-type="str">Status <span class="sort-icon">⇅</span></th>
                            <th class="text-center col-sticky-report">Report</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pumps)
                        {
                            <tr data-pump-id="@p.PumpId">
                                <td class="text-nowrap">
                                    <span class="fw-semibold">@p.PumpId</span>
                                    <button type="button"
                                            class="btn btn-link btn-sm p-0 ms-1 align-baseline pump-info-btn"
                                            title="View pump details"
                                            aria-label="View pump details"
                                            onclick="openPumpDetail('@p.PumpId', '@(p.VendorName ?? "")', '@(p.Location ?? "")', '@(p.Status ?? "OFF")', '@(p.OperatorName ?? "")', '@(p.OperatorMobile ?? "")', '@(p.JeName ?? "")', '@(p.JeMobile ?? "")')">
                                        <i class="bi bi-info-circle-fill"></i>
                                    </button>
                                </td>
                                <td>@p.VendorName</td>
                                <td>@p.Location</td>
                                <td class="small">
                                    @if (p.OperatorName != null)
                                    {
                                        <span class="fw-semibold">@p.OperatorName</span><br/>
                                        <span class="text-muted">@(p.OperatorMobile ?? "")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (p.JeName != null)
                                    {
                                        <span class="fw-semibold">@p.JeName</span><br/>
                                        <span class="text-muted">@(p.JeMobile ?? "")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="col-sticky-right text-center">
                                    @if (p.Status == "ON")
                                    {
                                        <span class="badge-status-on">ON</span>
                                    }
                                    else if (p.Status == "OFF")
                                    {
                                        <span class="badge-status-off">OFF</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-maint">MAINT</span>
                                    }
                                </td>
                                <td class="text-center col-sticky-report">
                                    <button class="btn btn-success btn-sm px-2 py-1"
                                            title="Report Issue via WhatsApp"
                                            onclick="openComplaintModal('@p.PumpId', '@(p.VendorName ?? "")', '@(p.Location ?? "")', '@(p.Status ?? "OFF")', '@(p.OperatorName ?? "")', '@(p.OperatorMobile ?? "")', '@(p.JeName ?? "")', '@(p.JeMobile ?? "")')">
                                        <i class="bi bi-whatsapp"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div><!-- /table-responsive -->
                <!-- Fixed footer — sits at the bottom of the card regardless of scroll -->
            </div><!-- /card -->
        </div><!-- /tableCol -->
    </div><!-- /dashboardRow -->
</div><!-- /container -->

<!-- ================= PUMP DETAIL MODAL ================= -->
<div class="modal fade" id="pumpDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i>
                    Pump Detail — <span id="pdPumpId"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Summary row -->
                <div class="row g-3 mb-3">
                    <div class="col-sm-4">
                        <div class="fw-semibold text-muted small">Vendor</div>
                        <div id="pdVendor"></div>
                    </div>
                    <div class="col-sm-4">
                        <div class="fw-semibold text-muted small">Location</div>
                        <div id="pdLocation"></div>
                    </div>
                    <div class="col-sm-4">
                        <div class="fw-semibold text-muted small">Status</div>
                        <div id="pdStatus"></div>
                    </div>
                </div>

                <!-- Contacts row -->
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <div class="fw-semibold text-muted small">
                            <i class="bi bi-person-fill me-1"></i>Operator
                        </div>
                        <div id="pdOperator">—</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="fw-semibold text-muted small">
                            <i class="bi bi-person-vcard-fill me-1"></i>Junior Engineer
                        </div>
                        <div id="pdJe">—</div>
                    </div>
                </div>

                <!-- Log table -->
                <h6 class="fw-bold mb-2">Status History</h6>
                <div id="pdLogSpinner" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2 text-muted">Loading…</span>
                </div>
                <div id="pdLogEmpty" class="text-muted small d-none">No history found.</div>
                <div class="table-responsive d-none" id="pdLogTableWrap">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Old</th>
                                <th>New</th>
                                <th>Started</th>
                                <th>Ended</th>
                                <th>Duration</th>
                                <th>Remarks</th>
                                <th>Operator</th>
                            </tr>
                        </thead>
                        <tbody id="pdLogBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= COMPLAINT MODAL ================= -->
<div class="modal fade" id="complaintModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="complaintForm">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="background:#25D366; color:#fff;">
                    <h5 class="modal-title">
                        <i class="bi bi-whatsapp me-1"></i> Report Issue
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cmpPumpId" />
                    <input type="hidden" id="cmpVendor" />
                    <input type="hidden" id="cmpOperatorName" />
                    <input type="hidden" id="cmpOperatorMobile" />
                    <input type="hidden" id="cmpJeName" />
                    <input type="hidden" id="cmpJeMobile" />

                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold text-muted small">Pump ID</label>
                            <input type="text" class="form-control form-control-sm" id="cmpPumpIdDisplay" readonly />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold text-muted small">Vendor</label>
                            <input type="text" class="form-control form-control-sm" id="cmpVendorDisplay" readonly />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold text-muted small">Location</label>
                            <input type="text" class="form-control form-control-sm" id="cmpLocationDisplay" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Dashboard Status</label>
                        <div id="cmpDashStatusBadge"></div>
                        <input type="hidden" id="cmpDashStatus" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Actual Status on Ground <span class="text-danger">*</span></label>
                        <select class="form-select" id="cmpActualStatus" required onchange="toggleOtherStatus()">
                            <option value="">— Select —</option>
                            <option value="ON">ON</option>
                            <option value="OFF">OFF</option>
                            <option value="NOT_WORKING">NOT WORKING</option>
                            <option value="OTHER">OTHER</option>
                        </select>
                        <input type="text" class="form-control mt-2 d-none" id="cmpActualStatusOther"
                               placeholder="Describe the actual status" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Complainant Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cmpName" placeholder="Your name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Complainant Mobile <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cmpMobile" placeholder="10-digit mobile" required
                               pattern="[0-9]{10}" maxlength="10" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Attach Photo <span class="text-muted small">(optional, max 10 MB)</span>
                        </label>
                        <input type="file" class="form-control" id="cmpPhoto"
                               accept="image/*" capture="environment"
                               onchange="previewComplaintPhoto(event)" />
                        <div id="cmpPhotoPreviewWrap" class="mt-2 d-none">
                            <img id="cmpPhotoPreview" alt="Selected photo"
                                 style="max-width:100%; max-height:160px; border:1px solid #dee2e6; border-radius:4px;" />
                            <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-2"
                                    onclick="clearComplaintPhoto()">
                                <i class="bi bi-x-circle"></i> Remove
                            </button>
                        </div>
                    </div>

                    <div id="cmpInfo" class="alert alert-info d-none small mb-0"></div>
                    <div id="cmpError" class="alert alert-danger d-none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn text-white" style="background:#25D366;"
                            onclick="submitComplaint()">
                        <i class="bi bi-whatsapp me-1"></i> Submit &amp; Send WhatsApp
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= LOGIN MODEL ================= -->
<div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Login">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Sign in</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input asp-for="LoginModel.Username" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="LoginModel.Password" type="password" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Are You Human?</label>
                        <div class="small text-muted mb-1">
                            Solve: <strong>@Model.CaptchaQuestion = ?</strong>
                        </div>
                        <input asp-for="LoginModel.CaptchaAnswer"
                               class="form-control"
                               inputmode="numeric"
                               autocomplete="off"
                               required />
                    </div>
                    @if (Model.LoginMessage != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.LoginMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Sign in</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.LoginMessage != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                loginModal.show();
            });
        </script>
    }
    <script>
        let map;
        let markersLayer;
        let lastRefreshTime = Date.now();
        const prevStatuses = {};

        document.addEventListener("DOMContentLoaded", () => {
            initLeafletMap();
        });

        const mapCenterLat = @Model.MapCenterLatitude;
        const mapCenterLng = @Model.MapCenterLongitude;
        const mapZoom = @Model.MapZoom;

        function initLeafletMap() {
            map = L.map('map').setView([mapCenterLat, mapCenterLng], mapZoom);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            markersLayer = L.markerClusterGroup({ maxClusterRadius: 60 }).addTo(map);

            loadPumpMarkers();
        }

        // ── Helpers for live DOM patching ───────────────────────────────────
        function statusHtml(status) {
            if (status === 'ON')
                return '<span class="badge-status-on">ON</span>';
            if (status === 'OFF')
                return '<span class="badge-status-off">OFF</span>';
            return '<span class="badge-status-maint">MAINT</span>';
        }

        function runningHtml(minutes) {
            if (!minutes || minutes <= 0) return '<span class="text-muted">—</span>';
            const h = Math.floor(minutes / 60), m = minutes % 60;
            return h > 0
                ? `<span class="text-success fw-semibold">${h} h ${m} m</span>`
                : `<span class="text-success fw-semibold">${m} m</span>`;
        }

        function loadPumpMarkers() {
            fetch('?handler=Refresh')
                .then(r => r.json())
                .then(data => {
                    // ── Update KPI cards ────────────────────────────────────
                    document.getElementById('kpiTotal').textContent   = data.totalPumps;
                    document.getElementById('kpiRunning').textContent = data.runningNow;
                    document.getElementById('kpiOffline').textContent = data.offlineCount;
                    document.getElementById('kpiMaint').textContent   = data.maintenanceCount;

                    // ── Rebuild map markers ─────────────────────────────────
                    markersLayer.clearLayers();

                    data.pumps.forEach(p => {
                        // Row flash on status change
                        if (prevStatuses[p.pumpId] !== undefined && prevStatuses[p.pumpId] !== p.status) {
                            const row = document.querySelector(
                                `.table-dashboard tbody tr[data-pump-id="${p.pumpId}"]`);
                            if (row) {
                                row.classList.remove('row-flash');
                                void row.offsetWidth; // force reflow
                                row.classList.add('row-flash');
                                setTimeout(() => row.classList.remove('row-flash'), 2000);
                            }
                        }
                        prevStatuses[p.pumpId] = p.status;

                        // ── Patch table row (running hours + status) ────────
                        const row = document.querySelector(
                            `.table-dashboard tbody tr[data-pump-id="${p.pumpId}"]`);
                        if (row) {
                            row.cells[5].innerHTML = statusHtml(p.status);
                            // Keep openPumpDetail onclick in sync (incl. operator + JE)
                            const btn = row.cells[0].querySelector('button');
                            if (btn) {
                                const v = (s) => (s || '').replace(/'/g, "\\'");
                                btn.setAttribute('onclick',
                                    `openPumpDetail('${p.pumpId}','${v(p.vendorName)}','${v(p.location)}','${p.status}','${v(p.operatorName)}','${v(p.operatorMobile)}','${v(p.jeName)}','${v(p.jeMobile)}')`);
                            }
                        }

                        if (p.latitude && p.longitude) addPumpMarker(p);
                    });

                    lastRefreshTime = Date.now();
                })
                .catch(err => console.error("Live refresh failed", err));
        }

        function addPumpMarker(pump) {
            const icon = getStatusIcon(pump.status);

            const marker = L.marker(
                [parseFloat(pump.latitude), parseFloat(pump.longitude)],
                { icon: icon }
            );

            const tooltip = `
                <strong>${pump.vendorName}</strong><br/>
                Location: ${pump.location ?? "—"}<br/>
                Status: ${pump.status}<br/>
                Last Updated: ${new Date(pump.lastUpdated).toLocaleString()}
            `;

            marker.bindTooltip(tooltip, { sticky: true, direction: 'top', opacity: 0.95 });
            markersLayer.addLayer(marker);
        }

        function getStatusIcon(status) {
            let iconFile = "marker-blue.png";

            if (status === "ON") iconFile = "marker-green.png";
            else if (status === "OFF") iconFile = "marker-red.png";
            else if (status === "MAINTENANCE") iconFile = "marker-yellow.png";

            return L.icon({
                iconUrl: `/images/${iconFile}`,
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                tooltipAnchor: [1, -34]
            });
        }

        // Auto-refresh every 30s — updates table rows, KPI cards and map markers live
        setInterval(loadPumpMarkers, 30000);

        // Live "last updated" label — ticks every second
        const lastUpdatedLabel = document.getElementById('lastUpdatedLabel');
        setInterval(function () {
            const elapsed = Math.floor((Date.now() - lastRefreshTime) / 1000);
            if (!lastUpdatedLabel) return;
            if (elapsed < 10) {
                lastUpdatedLabel.textContent = 'Updated just now';
            } else if (elapsed < 60) {
                lastUpdatedLabel.textContent = `Updated ${elapsed}s ago`;
            } else if (elapsed < 3600) {
                lastUpdatedLabel.textContent = `Updated ${Math.floor(elapsed / 60)} min ago`;
            } else {
                lastUpdatedLabel.textContent = `Updated ${Math.floor(elapsed / 3600)} hr ago`;
            }
        }, 1000);
    </script>
    <script>
        const dashboardRow    = document.getElementById('dashboardRow');
        const btnMap          = document.getElementById('btnMap');
        const btnList         = document.getElementById('btnList');
        const btnReset        = document.getElementById('btnReset');

        let currentView = null; // 'map' | 'list' | null

        btnMap.addEventListener('click', () => {
            if (currentView === 'map') { resetView(); } else { expandMap(); }
        });

        btnList.addEventListener('click', () => {
            if (currentView === 'list') { resetView(); } else { expandList(); }
        });

        btnReset.addEventListener('click', () => fullReset());

        function expandMap() {
            dashboardRow.classList.remove('expand-list');
            dashboardRow.classList.add('expand-map');
            btnMap.classList.add('active', 'btn-primary');
            btnMap.classList.remove('btn-outline-secondary');
            btnList.classList.remove('active', 'btn-primary');
            btnList.classList.add('btn-outline-secondary');
            currentView = 'map';
            setTimeout(() => map.invalidateSize(), 300);
        }

        function expandList() {
            dashboardRow.classList.remove('expand-map');
            dashboardRow.classList.add('expand-list');
            btnList.classList.add('active', 'btn-primary');
            btnList.classList.remove('btn-outline-secondary');
            btnMap.classList.remove('active', 'btn-primary');
            btnMap.classList.add('btn-outline-secondary');
            currentView = 'list';
        }

        function resetView() {
            dashboardRow.classList.remove('expand-map', 'expand-list');
            btnMap.classList.remove('active', 'btn-primary');
            btnMap.classList.add('btn-outline-secondary');
            btnList.classList.remove('active', 'btn-primary');
            btnList.classList.add('btn-outline-secondary');
            currentView = null;
            setTimeout(() => map.invalidateSize(), 300);
        }

        // ── Full reset: view + sort + status filter + search ─────────────
        function fullReset() {
            // 1. Reset view
            resetView();

            // 2. Reset column sort — restore original row order
            const tbody = document.querySelector('.table-dashboard tbody');
            const rows  = Array.from(tbody.querySelectorAll('tr'));
            rows.sort((a, b) =>
                parseInt(a.dataset.origIndex || 0) - parseInt(b.dataset.origIndex || 0)
            );
            rows.forEach(r => tbody.appendChild(r));

            // Clear sort icons + state
            document.querySelectorAll('.table-dashboard th.sortable').forEach(h => {
                h.classList.remove('sort-asc', 'sort-desc');
                const icon = h.querySelector('.sort-icon');
                if (icon) icon.textContent = '⇅';
            });

            // 3. Show all rows (in case sort hid any)
            document.querySelectorAll('.table-dashboard tbody tr')
                .forEach(tr => tr.style.display = '');

            // 4. Spin the reset icon for visual feedback
            const icon = btnReset.querySelector('i');
            icon.style.transition = 'transform 0.5s ease';
            icon.style.transform  = 'rotate(-360deg)';
            setTimeout(() => {
                icon.style.transition = '';
                icon.style.transform  = '';
            }, 500);
        }
    </script>

    <script>
        // ── Excel-style column sorting ──────────────────────────────────────
        (function () {
            // Track sort state per column: 'none' → 'asc' → 'desc' → 'none'
            const sortState = {};

            document.querySelectorAll('.table-dashboard th.sortable').forEach(th => {
                th.addEventListener('click', () => {
                    const col   = parseInt(th.dataset.col);
                    const type  = th.dataset.type;   // 'num' | 'str'
                    const table = th.closest('table');
                    const tbody = table.querySelector('tbody');
                    const rows  = Array.from(tbody.querySelectorAll('tr'));
                    const icon  = th.querySelector('.sort-icon');

                    // Cycle: none → asc → desc → none
                    const current = sortState[col] || 'none';
                    const next    = current === 'none' ? 'asc'
                                  : current === 'asc'  ? 'desc'
                                  : 'none';
                    sortState[col] = next;

                    // Reset all headers
                    document.querySelectorAll('.table-dashboard th.sortable').forEach(h => {
                        h.classList.remove('sort-asc', 'sort-desc');
                        h.querySelector('.sort-icon').textContent = '⇅';
                    });

                    if (next === 'none') {
                        // Restore original server-rendered order via data-index
                        rows.sort((a, b) =>
                            parseInt(a.dataset.origIndex) - parseInt(b.dataset.origIndex)
                        );
                        icon.textContent = '⇅';
                    } else {
                        th.classList.add(next === 'asc' ? 'sort-asc' : 'sort-desc');
                        icon.textContent = next === 'asc' ? '▲' : '▼';

                        rows.sort((a, b) => {
                            const aVal = a.cells[col].textContent.trim();
                            const bVal = b.cells[col].textContent.trim();

                            let cmp;
                            if (type === 'num') {
                                cmp = parseFloat(aVal || 0) - parseFloat(bVal || 0);
                            } else {
                                cmp = aVal.localeCompare(bVal, undefined, { sensitivity: 'base' });
                            }
                            return next === 'asc' ? cmp : -cmp;
                        });
                    }

                    // Re-attach rows in new order
                    rows.forEach(r => tbody.appendChild(r));
                });
            });

            // Stamp each row with its original index so we can restore order
            document.querySelectorAll('.table-dashboard tbody tr').forEach((tr, i) => {
                tr.dataset.origIndex = i;
            });
        })();

        // ── Pump detail modal ────────────────────────────────────────────────
        function openPumpDetail(pumpId, vendor, location, status,
                                opName, opMobile, jeName, jeMobile) {
            document.getElementById('pdPumpId').textContent  = pumpId;
            document.getElementById('pdVendor').textContent  = vendor   || '—';
            document.getElementById('pdLocation').textContent = location || '—';

            // Status badge
            const statusBadgeMap = {
                'ON':          '<span class="badge-status-on">ON</span>',
                'OFF':         '<span class="badge-status-off">OFF</span>',
                'MAINTENANCE': '<span class="badge bg-warning text-dark">MAINTENANCE</span>'
            };
            document.getElementById('pdStatus').innerHTML =
                statusBadgeMap[status] ?? '<span class="badge bg-secondary">UNKNOWN</span>';

            // Operator + JE contact blocks (name + tap-to-call mobile)
            const escHtml = s => (s == null) ? '' : String(s)
                .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                .replace(/"/g,'&quot;').replace(/'/g,'&#x27;');
            const renderContact = (name, mobile) => {
                const safeMobile = (mobile || '').replace(/[^0-9+]/g, '');
                if (!name && !safeMobile) return '<span class="text-muted">—</span>';
                let html = '';
                if (name)       html += `<div class="fw-semibold">${escHtml(name)}</div>`;
                if (safeMobile) html += `<a href="tel:${safeMobile}" class="text-decoration-none small">`
                                      +    `<i class="bi bi-telephone-fill me-1"></i>${escHtml(safeMobile)}`
                                      +  `</a>`;
                return html;
            };
            document.getElementById('pdOperator').innerHTML = renderContact(opName, opMobile);
            document.getElementById('pdJe').innerHTML       = renderContact(jeName, jeMobile);

            // Show spinner, hide others
            document.getElementById('pdLogSpinner').classList.remove('d-none');
            document.getElementById('pdLogEmpty').classList.add('d-none');
            document.getElementById('pdLogTableWrap').classList.add('d-none');
            document.getElementById('pdLogBody').innerHTML = '';

            // Show modal
            const modal = bootstrap.Modal.getOrCreateInstance(
                document.getElementById('pumpDetailModal'));
            modal.show();

            // Load history
            fetch(`?handler=PumpLogs&pumpId=${pumpId}`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('pdLogSpinner').classList.add('d-none');
                    if (!data.success || !data.logs || data.logs.length === 0) {
                        document.getElementById('pdLogEmpty').classList.remove('d-none');
                        return;
                    }
                    const tbody = document.getElementById('pdLogBody');
                    const esc = s => (s == null || s === '') ? '—' : String(s)
                        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                        .replace(/"/g,'&quot;').replace(/'/g,'&#x27;');
                    data.logs.forEach((l, i) => {
                        const fmt = dt => dt ? new Date(dt).toLocaleString('en-IN') : '—';
                        const dur = l.durationMinutes != null ? `${l.durationMinutes} min` : '—';
                        // Serial number per pump in chronological order:
                        // #1 = oldest event, #N = most recent. Rows are
                        // rendered newest-first, so the bottom row gets #1.
                        const serial = data.logs.length - i;
                        tbody.insertAdjacentHTML('beforeend', `
                            <tr>
                                <td class="text-muted small">${serial}</td>
                                <td>${esc(l.oldStatus)}</td>
                                <td><strong>${esc(l.newStatus)}</strong></td>
                                <td class="text-nowrap small">${fmt(l.startTime)}</td>
                                <td class="text-nowrap small">${fmt(l.endTime)}</td>
                                <td>${esc(dur)}</td>
                                <td>${esc(l.remarks)}</td>
                                <td>${esc(l.updatedBy)}</td>
                            </tr>`);
                    });
                    document.getElementById('pdLogTableWrap').classList.remove('d-none');
                })
                .catch(err => {
                    console.error('Failed to load pump logs', err);
                    document.getElementById('pdLogSpinner').classList.add('d-none');
                    document.getElementById('pdLogEmpty').textContent = 'Error loading history.';
                    document.getElementById('pdLogEmpty').classList.remove('d-none');
                });
        }


        // ── Complaint modal ──────────────────────────────────────────────────
        function openComplaintModal(pumpId, vendor, location, status, opName, opMobile, jeName, jeMobile) {
            document.getElementById('cmpPumpId').value          = pumpId;
            document.getElementById('cmpPumpIdDisplay').value   = pumpId;
            document.getElementById('cmpVendor').value          = vendor;
            document.getElementById('cmpVendorDisplay').value   = vendor || '—';
            document.getElementById('cmpLocationDisplay').value = location || '—';
            document.getElementById('cmpDashStatus').value      = status;
            document.getElementById('cmpOperatorName').value    = opName;
            document.getElementById('cmpOperatorMobile').value  = opMobile;
            document.getElementById('cmpJeName').value          = jeName;
            document.getElementById('cmpJeMobile').value        = jeMobile;

            const badgeMap = {
                'ON':          '<span class="badge-status-on">ON</span>',
                'OFF':         '<span class="badge-status-off">OFF</span>',
                'MAINTENANCE': '<span class="badge bg-warning text-dark">MAINTENANCE</span>'
            };
            document.getElementById('cmpDashStatusBadge').innerHTML =
                badgeMap[status] ?? '<span class="badge bg-secondary">UNKNOWN</span>';

            // Reset form fields
            document.getElementById('cmpActualStatus').value = '';
            document.getElementById('cmpActualStatusOther').value = '';
            document.getElementById('cmpActualStatusOther').classList.add('d-none');
            document.getElementById('cmpName').value         = '';
            document.getElementById('cmpMobile').value       = '';
            document.getElementById('cmpError').classList.add('d-none');
            document.getElementById('cmpInfo').classList.add('d-none');
            clearComplaintPhoto();

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('complaintModal'));
            modal.show();
        }

        function previewComplaintPhoto(ev) {
            const file = ev.target.files && ev.target.files[0];
            const wrap = document.getElementById('cmpPhotoPreviewWrap');
            const img  = document.getElementById('cmpPhotoPreview');
            if (!file) { wrap.classList.add('d-none'); img.src = ''; return; }
            // 10 MB hard cap (mirrors server limit; warn the user early).
            if (file.size > 10 * 1024 * 1024) {
                alert('Photo is larger than 10 MB. Please pick a smaller image.');
                clearComplaintPhoto();
                return;
            }
            const reader = new FileReader();
            reader.onload = e => { img.src = e.target.result; wrap.classList.remove('d-none'); };
            reader.readAsDataURL(file);
        }

        function clearComplaintPhoto() {
            const input = document.getElementById('cmpPhoto');
            if (input) input.value = '';
            const wrap = document.getElementById('cmpPhotoPreviewWrap');
            const img  = document.getElementById('cmpPhotoPreview');
            if (wrap) wrap.classList.add('d-none');
            if (img)  img.src = '';
        }

        function toggleOtherStatus() {
            const sel = document.getElementById('cmpActualStatus');
            const otherInput = document.getElementById('cmpActualStatusOther');
            if (sel.value === 'OTHER') {
                otherInput.classList.remove('d-none');
                otherInput.focus();
            } else {
                otherInput.classList.add('d-none');
                otherInput.value = '';
            }
        }

        async function submitComplaint() {
            let actualStatus = document.getElementById('cmpActualStatus').value;
            if (actualStatus === 'OTHER') {
                actualStatus = document.getElementById('cmpActualStatusOther').value.trim();
                if (!actualStatus) {
                    const errEl = document.getElementById('cmpError');
                    errEl.textContent = 'Please describe the actual status.';
                    errEl.classList.remove('d-none');
                    return;
                }
            }
            const mobile = document.getElementById('cmpMobile').value.trim();
            const name   = document.getElementById('cmpName').value.trim();
            const errEl  = document.getElementById('cmpError');
            const infoEl = document.getElementById('cmpInfo');

            if (!actualStatus || !mobile || !name) {
                errEl.textContent = 'Complainant Name, Actual Status, and Mobile are required.';
                errEl.classList.remove('d-none');
                return;
            }
            if (!/^\d{10}$/.test(mobile)) {
                errEl.textContent = 'Please enter a valid 10-digit mobile number.';
                errEl.classList.remove('d-none');
                return;
            }
            errEl.classList.add('d-none');
            infoEl.classList.add('d-none');

            // Capture the chosen photo synchronously — if we can share it
            // through the OS share sheet later, we'll use this File directly.
            const photoInput = document.getElementById('cmpPhoto');
            const photoFile  = photoInput && photoInput.files && photoInput.files[0] ? photoInput.files[0] : null;

            // ── iOS Safari popup-blocker workaround ─────────────────────────
            // window.open() only honours the user-gesture token if it runs
            // SYNCHRONOUSLY inside the click handler. We open the tab now in
            // case we fall back to wa.me after the await. If Web Share takes
            // over, we close it.
            const waWindow = window.open('about:blank', '_blank');

            const token = document.querySelector('#complaintForm input[name="__RequestVerificationToken"]').value;

            const fd = new FormData();
            fd.append('PumpId',            document.getElementById('cmpPumpId').value);
            fd.append('Location',          document.getElementById('cmpLocationDisplay').value);
            fd.append('DashboardStatus',   document.getElementById('cmpDashStatus').value);
            fd.append('ActualStatus',      actualStatus);
            fd.append('VendorName',        document.getElementById('cmpVendor').value);
            fd.append('OperatorName',      document.getElementById('cmpOperatorName').value);
            fd.append('OperatorMobile',    document.getElementById('cmpOperatorMobile').value);
            fd.append('JeName',            document.getElementById('cmpJeName').value);
            fd.append('JeMobile',          document.getElementById('cmpJeMobile').value);
            fd.append('ComplainantName',   name);
            fd.append('ComplainantMobile', mobile);
            if (photoFile) fd.append('Photo', photoFile);

            try {
                const res  = await fetch('?handler=SubmitComplaint', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: fd
                });
                const data = await res.json();
                if (!data.success) {
                    if (waWindow) waWindow.close();
                    errEl.textContent = data.message || 'Failed to submit complaint.';
                    errEl.classList.remove('d-none');
                    return;
                }

                // Build the human-readable message from the URL we got back so
                // we can hand it to navigator.share() if available.
                let waText = '';
                try {
                    const u = new URL(data.whatsappUrl, window.location.origin);
                    waText = u.searchParams.get('text') || '';
                } catch (_) { /* ignore — waText stays empty */ }

                const canShareFile = photoFile && navigator.canShare && navigator.canShare({ files: [photoFile] });

                if (canShareFile) {
                    // Native share sheet — message + photo go to whichever app
                    // the user picks (WhatsApp on most phones).
                    try {
                        await navigator.share({ text: waText, files: [photoFile] });
                        if (waWindow) waWindow.close();
                        bootstrap.Modal.getInstance(document.getElementById('complaintModal')).hide();
                        return;
                    } catch (shareErr) {
                        // User dismissed the share sheet, or the API rejected
                        // — fall through to the wa.me path so they still have
                        // a way to send.
                        console.warn('navigator.share failed, falling back to wa.me', shareErr);
                    }
                }

                // Fallback: wa.me opens with the message pre-filled. If there
                // was a photo, show a banner reminding the user to attach it
                // manually with WhatsApp's paperclip icon.
                bootstrap.Modal.getInstance(document.getElementById('complaintModal')).hide();
                if (waWindow && !waWindow.closed) {
                    waWindow.location.href = data.whatsappUrl;
                } else {
                    window.location.href = data.whatsappUrl;
                }
                if (photoFile) {
                    // The modal is hidden now, but for the next time the user
                    // opens it we'll have cleared the input via clearComplaintPhoto.
                    // Use an alert as the only reliable cross-tab signal.
                    setTimeout(() => alert(
                        'Tap the paperclip in WhatsApp and attach the photo — ' +
                        'this browser couldn\'t send it together with the message.'
                    ), 300);
                }
            } catch (err) {
                if (waWindow) waWindow.close();
                console.error('submitComplaint failed', err);
                errEl.textContent = 'Error submitting complaint. Please try again.';
                errEl.classList.remove('d-none');
            }
        }

        // ── Column resize handles ────────────────────────────────────────────
        (function() {
            const table = document.querySelector('.table-dashboard');
            if (!table) return;
            Array.from(table.querySelectorAll('th')).forEach(th => {
                const resizer = document.createElement('div');
                resizer.className = 'col-resizer';
                th.appendChild(resizer);
                th.style.position = 'relative';

                let startX, startW;
                resizer.addEventListener('mousedown', e => {
                    startX = e.pageX;
                    startW = th.offsetWidth;
                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                    e.preventDefault();
                });
                function onMove(e) { th.style.width = (startW + e.pageX - startX) + 'px'; }
                function onUp()   { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', onUp); }
            });
        })();
    </script>
}
