@page
@model asset_monitoring.Pages.DashboardModel
@{
    ViewData["Title"] = "Monsoon Pump Dashboard";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<!-- ================= HEADER ================= -->
<div class="container">
    <div class="container mb-4">
        <div class="row align-items-center">

            <!-- LEFT -->
            <div class="col-4 d-flex align-items-center gap-2">
                <button class="btn btn-outline-primary">EN / HI</button>
                <button class="btn btn-outline-primary"
                        onclick="window.location.href='?handler=DownloadReport'">
                    <i class="bi bi-download"></i>
                </button>
            </div>

            <!-- CENTER -->
            <div class="col-4 text-center">
                <h2 class="fw-bold text-primary m-0 dashboard-title">
                    Monsoon Pump Dashboard
                </h2>
            </div>

            <!-- RIGHT -->
            <div class="col-4 d-flex justify-content-end">
                <button class="btn btn-outline-primary d-flex align-items-center gap-2 px-3 py-2"
                        data-bs-toggle="modal"
                        data-bs-target="#loginModal">
                    <img src="~/images/user-logo.png"
                         alt="User"
                         style="height:28px;width:28px;" />
                    <span class="fw-semibold">Sign in</span>
                </button>
            </div>

        </div>
    </div>


    <!-- ================= KPI SECTION ================= -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Total Pumps</div>
                <div class="kpi-value">@Model.TotalPumps</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Running Now</div>
                <div class="kpi-value text-success">@Model.RunningPumpCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Total Runtime</div>
                <div class="kpi-value">@Model.AvgRuntime</div>
            </div>
        </div>
    </div>

    <!-- ================= MAP / LIST TOGGLE ================= -->
    <div class="mb-3">
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm view-btn" id="btnMap">MAP VIEW</button>
            <button class="btn btn-outline-secondary btn-sm view-btn" id="btnList">LIST VIEW</button>
        </div>
    </div>

    <!-- ================= MAP + TABLE ================= -->
    <div class="row g-3 mb-4" id="dashboardRow">
        <div class="col-12 col-md-6" id="mapCol">
            <div class="card h-100 p-3">
                <div id="map" style="height: 100%; min-height: 400px;">
                    <div class="text-muted">Pump Locations</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6" id="tableCol">
            <div class="card h-100 d-flex flex-column">
                <div class="table-responsive flex-grow-1">
                <table class="table table-dashboard mb-2 align-middle">
                    <thead>
                        <tr>
                            <th>Pump ID</th>
                            <th>Vendor</th>
                            <th>Location</th>
                            <th>Mobile</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pumps)
                        {
                            <tr>
                                <td>@p.PumpId</td>
                                <td>@p.VendorName</td>
                                <td>@p.Location</td>
                                <td>@p.MobileNumber</td>
                                <td>
                                    @if (p.Status == "ON")
                                    {
                                        <span class="badge-status-on">ON</span>
                                    }
                                    else if (p.Status == "OFF")
                                    {
                                        <span class="badge-status-off">OFF</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">MAINTENANCE</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary btn-sm">
                        <i class="bi bi-exclamation-circle"></i> Report Issue
                    </button>
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<!-- ================= LOGIN MODEL ================= -->
<div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Login">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Sign in</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input asp-for="LoginModel.Username" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="LoginModel.Password" type="password" class="form-control" />
                    </div>
                    @if (Model.LoginMessage != null)
                    {
                        <div class="alert alert-info">@Model.LoginMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Sign in</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        let map;
        let markersLayer;

        document.addEventListener("DOMContentLoaded", () => {
            initLeafletMap();
        });

        const mapCenterLat = @Model.MapCenterLatitude;
        const mapCenterLng = @Model.MapCenterLongitude;
        const mapZoom = @Model.MapZoom;

        function initLeafletMap() {
            map = L.map('map').setView([mapCenterLat, mapCenterLng], mapZoom);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            markersLayer = L.layerGroup().addTo(map);

            loadPumpMarkers();
        }

        function loadPumpMarkers() {
            fetch('?handler=Refresh')
                .then(r => r.json())
                .then(data => {
                    markersLayer.clearLayers();

                    data.pumps.forEach(p => {
                        if (p.latitude && p.longitude) {
                            addPumpMarker(p);
                        }
                    });
                })
                .catch(err => console.error("Map data load failed", err));
        }

        function addPumpMarker(pump) {
            const icon = getStatusIcon(pump.status);

            const marker = L.marker(
                [parseFloat(pump.latitude), parseFloat(pump.longitude)],
                { icon: icon }
            );

            const popup = `
                <strong>${pump.vendorName}</strong><br/>
                Location: ${pump.location ?? "-"}<br/>
                Status: ${pump.status}<br/>
                Last Updated: ${new Date(pump.lastUpdated).toLocaleString()}
            `;

            marker.bindPopup(popup);
            markersLayer.addLayer(marker);
        }

        function getStatusIcon(status) {
            let iconFile = "marker-blue.png";

            if (status === "ON") iconFile = "marker-green.png";
            else if (status === "OFF") iconFile = "marker-red.png";
            else if (status === "MAINTENANCE") iconFile = "marker-yellow.png";

            return L.icon({
                iconUrl: `/images/${iconFile}`,
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34]
            });
        }

        setInterval(loadPumpMarkers, 30000);
    </script>
    <script>
        const dashboardRow = document.getElementById('dashboardRow');
        const btnMap = document.getElementById('btnMap');
        const btnList = document.getElementById('btnList');

        let currentView = null; // 'map' | 'list' | null

        btnMap.addEventListener('click', () => {
            if (currentView === 'map') {
                resetView();
            } else {
                expandMap();
            }
        });

        btnList.addEventListener('click', () => {
            if (currentView === 'list') {
                resetView();
            } else {
                expandList();
            }
        });

        function expandMap() {
            dashboardRow.classList.remove('expand-list');
            dashboardRow.classList.add('expand-map');

            btnMap.classList.add('active');
            btnList.classList.remove('active');

            currentView = 'map';
            setTimeout(() => map.invalidateSize(), 300);
        }

        function expandList() {
            dashboardRow.classList.remove('expand-map');
            dashboardRow.classList.add('expand-list');

            btnList.classList.add('active');
            btnMap.classList.remove('active');

            currentView = 'list';
        }

        function resetView() {
            dashboardRow.classList.remove('expand-map', 'expand-list');

            btnMap.classList.remove('active');
            btnList.classList.remove('active');

            currentView = null;
            setTimeout(() => map.invalidateSize(), 300);
        }
    </script>





}
