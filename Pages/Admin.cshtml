@page
@model asset_monitoring.Pages.AdminModel
@{
    ViewData["Title"] = "Admin Panel";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container">
@await Html.PartialAsync("Shared/_LoginHeader", Model)
    <!-- Refresh Data -->
    <div class="d-flex justify-content-end mb-3">
        <a href="?handler=RefreshData" class="btn btn-outline-secondary btn-sm" title="Clear cache and reload fresh data from database">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh Data
        </a>
    </div>
    <!-- User Management Card -->
    <div class="card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-semibold text-primary m-0">
                <i class="bi bi-people-fill icon-title"></i>
                User Management
            </h5>
            <button type="button" class="btn btn-primary btn-sm" onclick="openAddUserDrawer()">
                <i class="bi bi-plus-lg"></i> Add User
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-dashboard align-middle">
                <thead>
                    <tr>
                        <th>NAME</th>
                        <th>ROLE</th>
                        <th>MOBILE NO.</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr data-user-id="@user.UserId">
                        <td class="user-name">@user.Name</td>
                        <td class="user-role">
                            <span class="badge-role">@user.UserType?.ToString().ToUpperInvariant()</span>
                        </td>
                        <td class="user-mobile">@user.MobileNumber</td>
                        <td>
                            <button type="button" class="btn btn-outline-primary btn-sm edit-user-btn" title="Edit"
                                    data-uid="@user.UserId"
                                    data-name="@user.Name"
                                    data-username="@(user.Username ?? "")"
                                    data-role="@user.UserType"
                                    data-mobile="@user.MobileNumber"
                                    data-active="@user.IsActive.ToString().ToLower()">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" title="Delete"
                                    onclick="deleteUser(@user.UserId)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pump Inventory Card -->
    @await Html.PartialAsync("Shared/_PumpInventory",Model.Pumps)

    <!-- Pump Running Summary -->
    @await Html.PartialAsync("Shared/_PumpRunningSummary", Model.RunningSummary)

    <!-- Complaint Log Card -->
    @await Html.PartialAsync("Shared/_ComplaintLog", new asset_monitoring.Models.ComplaintLogViewModel
    {
        Complaints = Model.Complaints,
        OpenComplaintCount = Model.OpenComplaintCount,
        ShowExports = true,
        ShowActions = true
    })

    <!-- Settings Card -->
    <div class="card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-semibold text-primary m-0">
                <i class="bi bi-gear-fill icon-title"></i>
                Settings
            </h5>
        </div>
        <form id="settingsForm">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Complaint WhatsApp &mdash; Send To</label>
                    @{
                        var sendToVal = Model.AppSettings.GetValueOrDefault("complaint_whatsapp_send_to", "Fixed Number");
                    }
                    <select class="form-select" id="settingSendTo">
                        <option value="JE Mobile" selected="@(sendToVal == "JE Mobile")">JE Mobile</option>
                        <option value="Fixed Number" selected="@(sendToVal == "Fixed Number")">Fixed Number</option>
                        <option value="Both" selected="@(sendToVal == "Both")">Both</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Fixed WhatsApp Number</label>
                    <input type="text" class="form-control" id="settingFixedNumber"
                           value="@Model.AppSettings.GetValueOrDefault("complaint_whatsapp_number", "")"
                           placeholder="e.g. 919680111439" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">WhatsApp Message Template</label>
                    <textarea class="form-control" id="settingTemplate" rows="6"
                              placeholder="Use placeholders: {pump_id}, {vendor}, {location}, {status}, {actual_status}, {operator_name}, {operator_mobile}, {je_name}, {je_mobile}, {complainant_name}, {complainant_mobile}">@Model.AppSettings.GetValueOrDefault("complaint_message_template", "")</textarea>
                    <small class="text-muted">
                        Available tokens: <code>{pump_id}</code> <code>{vendor}</code> <code>{location}</code>
                        <code>{status}</code> <code>{actual_status}</code> <code>{operator_name}</code>
                        <code>{operator_mobile}</code> <code>{je_name}</code> <code>{je_mobile}</code>
                        <code>{complainant_name}</code> <code>{complainant_mobile}</code>
                    </small>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Complaint Drive Folder</label>
                    <input type="text" class="form-control" id="settingDriveFolder"
                           value="@Model.AppSettings.GetValueOrDefault("complaint_drive_folder", "")"
                           placeholder="Google Drive link (optional)" />
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary" onclick="saveSettings()">
                        <i class="bi bi-check-circle me-1"></i> Save Settings
                    </button>
                    <span id="settingsSaveMsg" class="ms-2 text-success fw-semibold d-none">
                        <i class="bi bi-check2"></i> Saved
                    </span>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Pump Editor Drawer -->
@await Html.PartialAsync("_EditPumpDrawer")

<!-- Add Pump button wired via site.js openAddPumpDrawer() — injected by _PumpInventory partial -->

<!-- Update / Add User Drawer -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="editUserDrawer">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="userDrawerTitle">
            <i class="bi bi-pencil-square"></i> Edit User
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form id="editUserForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editUserId" />
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" id="editUserName" />
            </div>
            <div class="mb-3">
                <label class="form-label">Username <span class="text-danger">*</span> <small class="text-muted">(used to login)</small></label>
                <input type="text" class="form-control" id="editUserUsername" placeholder="e.g. admin_1, je_user" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select class="form-select" id="editUserRole">
                    <option value="ADMIN">ADMIN</option>
                    <option value="OPERATOR">OPERATOR</option>
                    <option value="JE">JE</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Mobile Number</label>
                <input type="text" class="form-control" id="editUserMobile" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" id="editUserPassword" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="editUserActive" checked>
                <label class="form-check-label">Active</label>
            </div>
            <button type="button" id="userDrawerSaveBtn" class="btn btn-success w-100" onclick="saveUser()">
                <i class="bi bi-check-circle"></i> Save Changes
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/admin-drawer.js"></script>
<script>
    // ── User drawer helpers ───────────────────────────────────────────────────
    let userDrawer = null;

    function getUserDrawer() {
        const el = document.getElementById('editUserDrawer');
        return bootstrap.Offcanvas.getInstance(el) ?? new bootstrap.Offcanvas(el);
    }

    function openEditUserDrawer(btn) {
        const d = btn.dataset;
        document.getElementById('editUserId').value        = d.uid;
        document.getElementById('editUserName').value      = d.name;
        document.getElementById('editUserUsername').value  = d.username ?? '';
        document.getElementById('editUserRole').value      = d.role;
        document.getElementById('editUserMobile').value    = d.mobile;
        document.getElementById('editUserPassword').value  = '';
        document.getElementById('editUserActive').checked  = (d.active === 'true');

        document.getElementById('userDrawerTitle').innerHTML =
            '<i class="bi bi-pencil-square"></i> Edit User';
        document.getElementById('userDrawerSaveBtn').textContent = 'Save Changes';

        userDrawer = getUserDrawer();
        userDrawer.show();
    }

    function openAddUserDrawer() {
        document.getElementById('editUserId').value        = '0';
        document.getElementById('editUserName').value      = '';
        document.getElementById('editUserUsername').value  = '';
        document.getElementById('editUserRole').value      = 'OPERATOR';
        document.getElementById('editUserMobile').value    = '';
        document.getElementById('editUserPassword').value  = '';
        document.getElementById('editUserActive').checked  = true;

        document.getElementById('userDrawerTitle').innerHTML =
            '<i class="bi bi-person-plus"></i> Add User';
        document.getElementById('userDrawerSaveBtn').textContent = 'Add User';

        userDrawer = getUserDrawer();
        userDrawer.show();
    }

    async function saveUser() {
        const userId  = parseInt(document.getElementById('editUserId').value);
        const isEdit  = userId > 0;
        const token   = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const handler = isEdit ? 'UpdateUser' : 'AddUser';

        const payload = {
            UserId:       userId,
            Name:         document.getElementById('editUserName').value.trim(),
            Username:     document.getElementById('editUserUsername').value.trim(),
            UserType:     document.getElementById('editUserRole').value,
            MobileNumber: document.getElementById('editUserMobile').value.trim(),
            Password:     document.getElementById('editUserPassword').value,
            IsActive:     document.getElementById('editUserActive').checked
        };

        if (!payload.Name || !payload.MobileNumber || !payload.Username) {
            alert('Name, Username and Mobile Number are required.');
            return;
        }

        try {
            const res  = await fetch(`?handler=${handler}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) { userDrawer.hide(); location.reload(); }
            else alert('Failed: ' + (data.message ?? 'Unknown error'));
        } catch (err) {
            console.error(err);
            alert('Error saving user');
        }
    }

    async function deleteUser(userId) {
        if (!confirm('Deactivate this user? They will no longer be able to log in.')) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        try {
            const res  = await fetch(`?handler=DeleteUser&id=${userId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const data = await res.json();
            if (data.success) location.reload();
            else alert('Failed to deactivate user: ' + (data.message ?? 'Unknown error'));
        } catch (err) {
            console.error(err);
            alert('Error deleting user');
        }
    }

    // Complaint actions live in the shared _ComplaintLog partial's script block.

    // ── Settings save ───────────────────────────────────────────────────────
    async function saveSettings() {
        const token = document.querySelector('#settingsForm input[name="__RequestVerificationToken"]').value;
        const payload = {
            SendTo:          document.getElementById('settingSendTo').value,
            FixedNumber:     document.getElementById('settingFixedNumber').value.trim(),
            MessageTemplate: document.getElementById('settingTemplate').value,
            DriveFolder:     document.getElementById('settingDriveFolder').value.trim()
        };

        try {
            const res = await fetch('?handler=SaveSettings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                const msg = document.getElementById('settingsSaveMsg');
                msg.classList.remove('d-none');
                setTimeout(() => msg.classList.add('d-none'), 3000);
            } else {
                alert('Failed to save settings: ' + (data.message ?? 'Unknown error'));
            }
        } catch (err) {
            console.error(err);
            alert('Error saving settings');
        }
    }

    // ── Wire buttons on DOM ready ─────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        // Edit User buttons
        document.querySelectorAll('.edit-user-btn').forEach(btn => {
            btn.addEventListener('click', () => openEditUserDrawer(btn));
        });
        // Add Pump button from _PumpInventory partial
        document.querySelectorAll('.admin-add-btn[data-target="pump"]').forEach(btn => {
            btn.addEventListener('click', openAddPumpDrawer);
        });
    });
</script>
}
