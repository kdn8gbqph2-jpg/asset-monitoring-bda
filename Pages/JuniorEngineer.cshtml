@page
@model asset_monitoring.Pages.JuniorEngineerModel
@{
    ViewData["Title"] = "JE Dashboard";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="container">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("Shared/_LoginHeader", Model)

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary m-0">
            <i class="bi bi-clipboard-data"></i> Junior Engineer Dashboard
        </h4>
        <span class="text-muted small">Read-only pump overview · Assign operators</span>
    </div>

    <!-- KPI row -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Total Pumps</div>
                <div class="kpi-value">@Model.Pumps.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Running Now</div>
                <div class="kpi-value text-success">@Model.Pumps.Count(p => p.Status == "ON")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Offline</div>
                <div class="kpi-value text-danger">@Model.Pumps.Count(p => p.Status == "OFF")</div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("Shared/_JEPumpInventory", Model.Pumps)
</div>

<!-- ── Assign Operator Modal ─────────────────────────────────────────── -->
<div class="modal fade" id="assignOperatorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-person-check"></i> Assign Operator
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="aoPumpId" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Pump ID</label>
                    <input type="text" class="form-control" id="aoPumpIdDisplay" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Operator Mobile Number</label>
                    <input type="text" class="form-control" id="aoMobile"
                           placeholder="e.g. 9876543210" maxlength="15" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAssignment()">
                    <i class="bi bi-check-circle"></i> Assign
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function openAssignOperator(pumpId, currentMobile) {
            document.getElementById('aoPumpId').value        = pumpId;
            document.getElementById('aoPumpIdDisplay').value = pumpId;
            document.getElementById('aoMobile').value        = currentMobile ?? '';

            const modal = bootstrap.Modal.getOrCreateInstance(
                document.getElementById('assignOperatorModal'));
            modal.show();
        }

        function saveAssignment() {
            const pumpId = parseInt(document.getElementById('aoPumpId').value);
            const mobile = document.getElementById('aoMobile').value.trim();

            if (!mobile) {
                alert('Please enter an operator mobile number.');
                return;
            }

            fetch('?handler=AssignOperator', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({ PumpId: pumpId, OperatorMobile: mobile })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    bootstrap.Modal.getInstance(
                        document.getElementById('assignOperatorModal')).hide();
                    location.reload();
                } else {
                    alert('Failed to assign operator: ' + (res.message ?? 'Unknown error'));
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error assigning operator.');
            });
        }
    </script>
}
