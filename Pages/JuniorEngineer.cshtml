@page
@model asset_monitoring.Pages.JuniorEngineerModel
@{
    ViewData["Title"] = "JE Dashboard";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="container">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("Shared/_LoginHeader", Model)

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary m-0">
            <i class="bi bi-clipboard-data"></i> Junior Engineer Dashboard
        </h4>
        <span class="text-muted small">Read-only pump overview · Assign operators</span>
    </div>

    <!-- KPI row -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Total Pumps</div>
                <div class="kpi-value">@Model.Pumps.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Running Now</div>
                <div class="kpi-value text-success">@Model.Pumps.Count(p => p.Status == "ON")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Offline</div>
                <div class="kpi-value text-danger">@Model.Pumps.Count(p => p.Status == "OFF")</div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("Shared/_JEPumpInventory", Model.Pumps)

    <!-- Pump Running Summary -->
    @await Html.PartialAsync("Shared/_PumpRunningSummary", Model.RunningSummary)

    <!-- Complaint Log (filtered to this JE's assigned complaints) -->
    @await Html.PartialAsync("Shared/_ComplaintLog", new asset_monitoring.Models.ComplaintLogViewModel
    {
        Complaints = Model.Complaints,
        OpenComplaintCount = Model.OpenComplaintCount,
        ShowExports = false,
        ShowActions = true
    })
</div>

<!-- Pump Editor Drawer (reuse shared partial) -->
@await Html.PartialAsync("_EditPumpDrawer")

@section Scripts {
}
