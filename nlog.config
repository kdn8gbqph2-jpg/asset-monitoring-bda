<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- default value — will be overridden at runtime from Program.cs -->
  <variable name="starttime" value="${date:format=yyyy_MM_dd_HH_mm_ss_fff}" />

  <targets>
    <!-- primary file target: filename includes application start timestamp (ms) via ${var:starttime} -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/log_${var:starttime}.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} [${level:uppercase=true}] ${message:raw}${onexception:${newline}${exception:format=toString:replaceNewLines=true:separator=${newline}${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} [${level:uppercase=true}] } }"
            encoding="utf-8"
            concurrentWrites="true"
            keepFileOpen="true"
            archiveAboveSize="20971520"                
            archiveNumbering="Rolling"
            maxArchiveFiles="10"
            archiveFileName="${basedir}/logs/archive/log_${var:starttime}.{#}.log" />

    <!-- console target for development -->
    <target xsi:type="Console" name="console" layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} [${level:uppercase=true}] ${message} ${exception:format=toString}" />
  </targets>

  <rules>
    <logger name="*" minLevel="Info" writeTo="file" />
    <logger name="*" minLevel="Debug" writeTo="console" />
  </rules>
</nlog>